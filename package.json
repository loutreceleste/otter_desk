{
  "name": "otter-desk",
  "version": "0.3.0",
  "description": "Gestionnaire local de commandes CLI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/generate-icon.js && electron-vite build",
